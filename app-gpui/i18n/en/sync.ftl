# Live mailbox sync (S4-03): status, errors, signing in again.
sync-connecting = Connecting to { $url }…
sync-signed-in = Signed in: { $user }
sync-loading = Loading { $mailbox }…
sync-synced = Synced
sync-store-upgrade = Updating storage: { $percent }%
sync-store-upgrade-hint = Once after a Postman update. Messages on the server don’t change.
sync-error = { $what }: { $detail }
sync-error-auth = The server rejected the sign-in
sync-error-network = No connection to the server
sync-error-server = Server error
sync-error-protocol = Unexpected server response
sync-error-storage = Local copy error
sync-error-internal = Sync did not start
sync-reauth = The server rejected the saved password: sign in again.
status-items-of = Items: { $n } of { $total }
fatal-bench-account = live mailbox benchmark: POSTMAN_URL and POSTMAN_USER/POSTMAN_PASSWORD (or POSTMAN_TOKEN) are required
# Error of an additional profile account (S7-03б): its login and the error text.
sync-account-error = { $account }: { $error }
