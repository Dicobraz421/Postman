# Messenger comforts (CMF-01, CMF-02): mute a conversation, pin.
comfort-group-pinned = Pinned
comfort-group-rest = Other
comfort-muted = { $n ->
    [one] Conversation muted: new messages arrive without notifications.
   *[other] { $n } conversations muted: new messages arrive without notifications.
}
comfort-unmuted = { $n ->
    [one] Conversation unmuted.
   *[other] { $n } conversations unmuted.
}
comfort-pinned = Pinned to the top of the folder.
comfort-unpinned = Unpinned.
comfort-pin-full = This folder already has { $n } pinned items. Unpin one to pin another.
comfort-read-only = The mailbox is read-only: the mark can't be set.
comfort-menu-pin = Pin
comfort-menu-unpin = Unpin
comfort-menu-mute = Mute conversation
comfort-menu-unmute = Unmute conversation
