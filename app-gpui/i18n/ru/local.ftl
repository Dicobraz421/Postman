# «На этом компьютере» и перенос между учётками (S8-15, макет S8-D «Перенос»).
local-group = На этом компьютере
local-group-hint = { $n ->
    [one] Хранится только в базе Postman на этом компьютере · { $count } письмо
    [few] Хранится только в базе Postman на этом компьютере · { $count } письма
   *[many] Хранится только в базе Postman на этом компьютере · { $count } писем
}
local-new-folder = Новая папка
local-rename = Переименовать
local-delete = Удалить
local-delete-not-empty = Удалить можно пустую папку
local-drop = { $n ->
    [one] Перенести { $n } письмо сюда
    [few] Перенести { $n } письма сюда
   *[many] Перенести { $n } писем сюда
}
