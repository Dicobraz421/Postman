# Удобства из мессенджеров (CMF-01, CMF-02): «Заглушить беседу», «Закрепить».
comfort-group-pinned = Закреплённые
comfort-group-rest = Остальные
comfort-muted = { $n ->
    [one] Беседа заглушена: новые письма придут без уведомлений.
    [few] { $n } беседы заглушены: новые письма придут без уведомлений.
   *[many] { $n } бесед заглушено: новые письма придут без уведомлений.
}
comfort-unmuted = { $n ->
    [one] Звук беседы возвращён.
    [few] Звук { $n } бесед возвращён.
   *[many] Звук { $n } бесед возвращён.
}
comfort-pinned = Закреплено вверху папки.
comfort-unpinned = Откреплено.
comfort-pin-full = В папке уже { $n } закреплённых — открепите одно, чтобы закрепить новое.
comfort-read-only = Ящик открыт только для чтения: признак не поставить.
comfort-menu-pin = Закрепить
comfort-menu-unpin = Открепить
comfort-menu-mute = Заглушить беседу
comfort-menu-unmute = Вернуть звук беседы
