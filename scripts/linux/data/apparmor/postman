# Postman (LIN-06): the worker and the viewer create an unprivileged user namespace for their sandbox (ADR 0010,
# seccomp + Landlock + namespaces). Ubuntu 23.10+ allows it only to binaries with a profile that says "userns".
# The profiles do not confine anything else (unconfined): the sandbox itself is the worker's. Installed by the deb and
# rpm (scripts/linux/data/apparmor.sh) only where AppArmor 4 is present.
abi <abi/4.0>,
include <tunables/global>

profile postman-worker /usr/bin/postman-worker flags=(unconfined) {
  userns,

  include if exists <local/postman-worker>
}

profile postman-viewer /usr/bin/postman-viewer flags=(unconfined) {
  userns,

  include if exists <local/postman-viewer>
}
